  "semantic_definitions": {
    "audit_opinion_type": {
      "inherited_stage125_definition": "Structured audit-opinion label taken only from an official CODAL audit report for predictor year t. The label must be an explicit structured field/value on the report (not inferred from free text). If the field is absent, unreadable, conflicting, or ambiguous => null.",
      "representation": "structured_categorical",
      "allowed_categories_must_be_prospectively_enumerated": true,
      "allowed_categories_source": "authoritative_audit_report_framework_not_empirical_inspection",
      "categories_derived_from_empirical_data_forbidden": true,
      "unclear_or_unsupported_classification": "missing_unresolved_never_guessed",
      "document": "official_CODAL_audit_report_year_t",
      "source_id": "src_m4_codal_audit"
    },
    "going_concern_flag": {
      "inherited_stage125_definition": "true only when the official CODAL audit report for year t contains an explicit structured going-concern / material-uncertainty indication set to true/present. false only when an explicit structured official field states negative/false for going-concern. Absent clause, missing field, unstructured-only text, conflict, or ambiguity => null/UNRESOLVED (never default false).",
      "representation": "binary_or_null",
      "basis": "explicit_reproducibly_defined_going_concern_signal_in_authoritative_audit_disclosure_only",
      "forbidden_inference_sources": [
        "accumulated_losses",
        "article_141_status",
        "negative_equity",
        "financial_ratios",
        "distress_outcome",
        "future_events"
      ],
      "llm_or_text_based_semantic_guessing_forbidden": true,
      "if_canonical_disclosure_cannot_support_deterministic_auditable_definition_prospectively": "candidate_becomes_UNRESOLVED_not_hand_interpreted",
      "document": "official_CODAL_audit_report_year_t",
      "source_id": "src_m4_codal_audit"
    },
    "audit_lag_days": {
      "inherited_stage125_definition": "audit_lag_days = calendar_days(fiscal_year_end, audit_report_date) using the official CODAL audit report date field and the predictor fiscal_year_end. Both dates must be semantic valid ISO calendar dates. If fiscal_year_end missing (LC08), or audit_report_date missing/ambiguous, or either date unparseable, or audit_report_date < fiscal_year_end (negative lag) => null/UNRESOLVED. Never impute dates or emit a negative lag.",
      "representation": "integer_calendar_days",
      "frozen_date_fields": {
        "field_1": "predictor_fiscal_year_end (official CODAL financial-statement fiscal_year_end field)",
        "field_2": "audit_report_date (official CODAL audit report date field)"
      },
      "calendar_conversion_convention": "Both fields must be normalized to Gregorian ISO calendar dates before differencing. The project's canonical calendar-handling precedent (locked in the M3-LAG-WDI calendar mapping, project/stage128/m3_lag_wdi_exploratory_calendar_mapping_lock/, rule jalali_fiscal_year_t_plus_621) establishes that any Jalali source date MUST be converted through a human-locked, evidence-based offset before use; no new offset is invented by this contract, and audit_lag_days must use whichever conversion is already authoritative for the CODAL audit-report date field at the time of the Gate, or remain UNRESOLVED if none is authoritative.",
      "difference_direction": "audit_report_date minus fiscal_year_end (non-negative only)",
      "report_date_is_not_automatically_availability_date": true,
      "report_date_before_cutoff_but_first_public_after_cutoff_is_not_available": "A report dated before the pair cutoff whose verified public availability (available_at) is after the cutoff is NOT point-in-time available; only available_at, never the document's internal date, governs usability.",
      "document": "official_CODAL_audit_report_year_t",
      "source_id": "src_m4_codal_audit"
    },
    "board_size": {
      "inherited_stage125_definition": "Integer count of board members from an official CODAL governance disclosure for year t, using an explicit auditable membership list/field. Ambiguous membership, missing list, or conflicting counts => null. Director networks remain out of scope.",
      "representation": "integer_count",
      "basis": "authoritative_board_composition_disclosure_applicable_at_the_prediction_cutoff",
      "backfilling_from_later_disclosures_forbidden": true,
      "future_board_composition_forbidden": true,
      "document": "official_CODAL_governance_disclosure_year_t",
      "source_id": "src_m4_codal_governance"
    }
  },

