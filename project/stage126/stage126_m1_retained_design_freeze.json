  "robustness_rationale": {
    "feature_set": {
      "finding": "Part 1 (six-feature target-proximity set) is the sole category where the primary model-family ordering is not preserved and all three families decline in pooled PR-AUC relative to the primary nine-feature set. This supports retaining the full M1_PRIMARY_FEATURE_ORDER nine-feature set rather than the reduced six-feature set.",
      "source_artifact": "project/stage126/stage126_m1_robustness_part1_primary_comparison.json"
    },
    "imbalance": {
      "finding": "Part 6 (training-fold-only SMOTENC/SMOTE, class weighting disabled) preserves the primary ordering but all three families decline in pooled PR-AUC relative to the primary class-weighted result, supporting retention of primary class weighting (not SMOTENC) as the frozen imbalance strategy.",
      "source_artifacts": [
        "project/stage126/stage126_m1_robustness_part6_primary_comparison.json",
        "project/stage126/stage126_m1_robustness_part6_resampling_audit.csv"
      ]
    },
    "model_families": {
      "finding": "Across the six robustness categories the primary ordering (regularized_logistic_regression > random_forest > xgboost) is preserved in 5 of 6 categories (all except Part 1). No robustness evidence in Parts 1-6 supports dropping any of the three retained model families or the previously selected, non-retuned configurations.",
      "source_artifact": "project/stage126/stage126_m1_robustness_closure_synthesis_record.json"
    },
    "sample": {
      "finding": "Parts 2, 3 and 4 (listing-timing Rule B, expanded Rule A company scope, and their Rule B combination) preserve the primary model-family ordering with small absolute pooled PR-AUC changes, supporting retention of the main_rule_a_primary sample as the frozen design sample.",
      "source_artifacts": [
        "project/stage126/stage126_m1_robustness_part2_primary_comparison.json",
        "project/stage126/stage126_m1_robustness_part3_primary_comparison.json",
        "project/stage126/stage126_m1_robustness_part4_primary_comparison.json"
      ]
    },
    "target": {
      "finding": "Part 5 (persistent-loss secondary target) increases pooled PR-AUC for all families but simultaneously changes the target definition and the development positive count (85 vs 68 primary, +17); this is target-definition sensitivity evidence, not a same-outcome gain, and supports retaining FD_target_main_t_plus_1 as the frozen target.",
      "source_artifact": "project/stage126/stage126_m1_robustness_part5_primary_comparison.json"
    }
  },
  "sample": "main_rule_a_primary",
